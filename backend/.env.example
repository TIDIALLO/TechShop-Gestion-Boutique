# ============================================================
# BoutiqueManager — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

SECRET_KEY=your-super-secret-key-change-this-in-production-50chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=boutique_db
DB_USER=boutique_user
DB_PASSWORD=boutique_password
DB_HOST=localhost
DB_PORT=5432

# Frontend
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email (confirmation de compte + alerte rupture de stock)
# Par défaut les e-mails s'affichent dans la console du backend (docker compose logs backend).
# Pour envoyer de vrais e-mails : mettre EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# et renseigner EMAIL_HOST_USER / EMAIL_HOST_PASSWORD (mot de passe d'application Gmail).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Géolocalisation
OPENCAGE_API_KEY=your-opencage-api-key

# Hôtes autorisés / origines CSRF (ajouter l'IP du PC pour tester depuis un téléphone sur le Wi-Fi)
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
